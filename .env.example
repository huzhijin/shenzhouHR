# Variable-name template only. Keep every real secret outside the repository.
# Production uses MySQL 8.4 LTS, native Nginx/systemd and cookie sessions.

SPRING_PROFILES_ACTIVE=
SHENZHOUHR_SERVER_ADDRESS=
SHENZHOUHR_SERVER_PORT=

SHENZHOUHR_DB_URL=
SHENZHOUHR_DB_USERNAME=
SHENZHOUHR_DB_PASSWORD=
SHENZHOUHR_DB_POOL_SIZE=
SHENZHOUHR_DB_MIN_IDLE=

SHENZHOUHR_FLYWAY_ENABLED=
SHENZHOUHR_FLYWAY_URL=
SHENZHOUHR_FLYWAY_USERNAME=
SHENZHOUHR_FLYWAY_PASSWORD=

SHENZHOUHR_SESSION_COOKIE_SECURE=
SHENZHOUHR_LOGIN_MAX_FAILURES=
SHENZHOUHR_LOGIN_FAILURE_WINDOW=
SHENZHOUHR_LOGIN_LOCK_DURATION=
SHENZHOUHR_SESSION_IDLE_TIMEOUT=
SHENZHOUHR_SESSION_ABSOLUTE_TIMEOUT=

# Deli E+ attendance integration. Keep actual values in ignored
# .env.deli.local or the production secret manager.
DELI_EPLUS_ENABLED=false
DELI_EPLUS_BASE_URL=https://v2-api.delicloud.com
DELI_EPLUS_APP_KEY=
DELI_EPLUS_APP_SECRET=
DELI_EPLUS_PAGE_SIZE=500
DELI_EPLUS_CONNECT_TIMEOUT=PT5S
DELI_EPLUS_REQUEST_TIMEOUT=PT15S
DELI_EPLUS_MAX_RESPONSE_BYTES=4194304
DELI_EPLUS_SOURCE_TIME_ZONE=Asia/Shanghai
DELI_EPLUS_CREDENTIAL_REFERENCE_NAME=DELI_EPLUS_APP_CREDENTIALS

# Optional OA MySQL read-only source. The database account itself must have
# only the approved SELECT grants; JDBC readOnly is an additional guard.
OA_MYSQL_ENABLED=false
OA_MYSQL_JDBC_URL=
OA_MYSQL_USERNAME=
OA_MYSQL_PASSWORD=
OA_MYSQL_MAX_POOL_SIZE=2
OA_MYSQL_CONNECTION_TIMEOUT=PT5S
OA_MYSQL_QUERY_TIMEOUT=PT3S

# Server-internal payroll reservation remains hidden and default-off.
SHENZHOUHR_PAYROLL_RESERVATION_ENABLED=false
