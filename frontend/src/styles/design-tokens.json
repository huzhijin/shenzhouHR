    "ink-400": {"$value": "oklch(71.07% 0.0351 256.79)", "$type": "color"},
    "ink-200": {"$value": "oklch(86.90% 0.0198 252.89)", "$type": "color"},
    "blue-50": {"$value": "oklch(95.38% 0.0161 262.75)", "$type": "color"},
    "blue-900": {"$value": "oklch(33.96% 0.1087 262.08)", "$type": "color"},
    "green-50": {"$value": "oklch(95.85% 0.0166 162.75)", "$type": "color"},
    "green-900": {"$value": "oklch(39.25% 0.0896 152.54)", "$type": "color"},
    "amber-50": {"$value": "oklch(97.17% 0.0231 75.86)", "$type": "color"},
    "amber-900": {"$value": "oklch(42.10% 0.0897 57.71)", "$type": "color"},
    "red-50": {"$value": "oklch(95.46% 0.0196 13.63)", "$type": "color"},
    "red-700": {"$value": "oklch(58.14% 0.2375 27.86)", "$type": "color"},
    "red-900": {"$value": "oklch(39.88% 0.1620 25.68)", "$type": "color"},
