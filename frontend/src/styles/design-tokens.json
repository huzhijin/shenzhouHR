{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Shenzhou HR Continuous Delivery Tokens",
    "version": "1.9.1",
    "register": "product",
    "status": "approved-v1.9-continuous-delivery",
    "designDirection": "technical-editorial / 航天蓝图档案",
    "memorableElement": "规则轨道：用一条克制的钴蓝时间轨道串联事实、规则、计算与审计，只在冲突或不可逆终点使用安全红。",
    "density": "controlled-density",
    "dominantColor": "deep-cobalt",
    "sharpAccent": "safety-red",
    "iconLibrary": "Tabler Icons",
    "iconPackage": "@tabler/icons-react",
    "iconStrokeWidth": 2,
    "emojiIconsAllowed": false,
    "contrastStandard": "WCAG 2.2 AA",
    "minimumBodyContrast": "4.5:1",
    "minimumLargeTextAndUiContrast": "3:1",
    "source": [
      "docs/docs-confirm-v1.9/design-tokens.json",
      "design/open-design/v1.9/design-system/design-tokens.json",
      "design/open-design/v1.9/component-inventory.md",
      "design/open-design/v1.9/page-state-matrix.md",
      "design/open-design/v1.9/responsive-screenshot-checklist.md"
    ],
    "consumer": "frontend/src/styles/design-tokens.css",
    "coverage": "WAVE-1 through self-service, reporting and attendance display; excluded surfaces receive no tokens"
  },
