    "link-hover": {"$value": "{color.brand-support}", "$type": "color"},
    "link-active": {"$value": "{color.brand-deep}", "$type": "color"},
    "row-hover": {"$value": "{color.surface-subtle}", "$type": "color"},
    "row-selected": {"$value": "{color.info-soft}", "$type": "color"},
    "state-neutral": {"$value": "{color.surface-subtle}", "$type": "color"},
    "on-state-neutral": {"$value": "{color.on-surface-subtle}", "$type": "color"},
    "state-loading": {"$value": "{color.info-soft}", "$type": "color"},
    "on-state-loading": {"$value": "{color.on-info-soft}", "$type": "color"},
    "state-empty": {"$value": "{color.surface-subtle}", "$type": "color"},
