  "border": {"$value": "{color.border}", "$type": "color"},
  "accent": {"$value": "{color.brand-primary}", "$type": "color"},
  "responsive": {
    "$extensions": {
      "org.shenzhouhr.viewportMatrix": [
        {"name": "mobile", "width": 390, "height": 844, "navigation": "bottom", "denseData": "labelled-record-cards"},
        {"name": "tablet-portrait", "width": 768, "height": 1024, "navigation": "drawer", "denseData": "responsive-table"},
        {"name": "tablet-landscape", "width": 1024, "height": 768, "navigation": "drawer", "denseData": "responsive-table"},
        {"name": "desktop", "width": 1366, "height": 768, "navigation": "sidebar", "denseData": "table"},
        {"name": "desktop-tall", "width": 1440, "height": 900, "navigation": "sidebar", "denseData": "table"},
        {"name": "wide", "width": 1920, "height": 1080, "navigation": "sidebar", "denseData": "table"}
      ],
      "rules": {
        "unexpectedPageHorizontalScroll": false,
        "minimumTouchTarget": "{size.touch-target}",
        "denseTableCardAtOrBelow": "{breakpoint.dense-table-max}",
        "displayCanvas": "1920x1080 scales uniformly to 3840x2160",
        "dialogOnMobile": "bottom-sheet or full-height drawer with safe-area padding"
      }
    }
  },
  "accessibility": {
    "$extensions": {
      "org.shenzhouhr.a11yContract": {
        "focus": "2px visible ring with 2px offset; 3px in prefers-contrast: more",
        "keyboard": "all actions reachable; dialogs trap focus, Escape closes, trigger regains focus",
        "touchTarget": "44x44px minimum",
        "errors": "field errors use aria-invalid and aria-describedby",
        "liveRegions": "progress uses role=status/polite; blocking failures use role=alert/assertive",
        "color": "status always includes text and shape; color is never the only signal",
        "motion": "all non-essential motion resolves to 0ms under prefers-reduced-motion",
        "contrast": "body >=4.5:1; large text and UI boundaries >=3:1"
      }
    }
  },
  "components": {
    "$extensions": {
      "org.shenzhouhr.componentStateContract": {
        "AppShell": ["loading", "ready", "sidebar-collapsed", "drawer-open", "mobile", "session-expired", "access-denied"],
        "PrimaryNavigation": ["default", "hover", "focus-visible", "active", "disabled"],
        "Button": ["default", "hover", "focus-visible", "active", "disabled", "loading"],
        "IconButton": ["default", "hover", "focus-visible", "active", "disabled", "loading"],
        "Link": ["default", "hover", "focus-visible", "active", "disabled"],
        "ControlledField": ["empty", "hover", "focus-visible", "filled", "invalid", "disabled", "read-only", "loading"],
        "CheckboxRadioSwitch": ["unchecked", "hover", "focus-visible", "checked", "indeterminate", "disabled", "invalid"],
        "DenseDataTable": ["loading", "empty", "default", "row-hover", "row-focus", "row-selected", "error", "forbidden"],
        "RecordCard": ["default", "hover", "focus-visible", "selected", "disabled"],
