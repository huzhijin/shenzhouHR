{
  "name": "shenzhou-hr-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "demo": "vite --mode demo --configLoader runner",
    "build": "tsc -b --force && vite build --configLoader runner",
    "build:demo": "tsc -b --force && vite build --mode demo --configLoader runner",
    "build:all": "npm run build && npm run build:demo",
    "typecheck": "tsc -b --force --pretty false",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner --cache=false",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@tabler/icons-react": "3.45.0",
    "antd": "6.5.1",
    "i18next": "26.3.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.11",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
