# Copy this template OUTSIDE the repository, fill the four password values,
# and chmod the resulting file to 0600. Values are raw text after the first
# "="; shell quoting and command substitution are intentionally unsupported.

SHENZHOUHR_MYSQL_HOST=localhost
SHENZHOUHR_MYSQL_PORT=3306
SHENZHOUHR_MYSQL_CLIENT_BIN=mysql
# Optional. Leave blank to use Flyway CLI when installed, otherwise the
# repository's Maven-backed Flyway 12 wrapper.
SHENZHOUHR_FLYWAY_BIN=
SHENZHOUHR_TEST_FINAL_STATE=PRESERVED

SHENZHOUHR_MYSQL_ROOT_PASSWORD=
SHENZHOUHR_FLYWAY_PASSWORD=
SHENZHOUHR_DEV_DB_PASSWORD=
SHENZHOUHR_TEST_DB_PASSWORD=
