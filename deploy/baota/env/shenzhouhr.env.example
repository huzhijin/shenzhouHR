# Copy to /etc/shenzhouhr/shenzhouhr.env and keep mode 0600 or 0640.
# The Baota installer generates real credentials; do not commit real values.
SPRING_PROFILES_ACTIVE=prod
SHENZHOUHR_SERVER_ADDRESS=0.0.0.0
SHENZHOUHR_SERVER_PORT=8080
SHENZHOUHR_DB_URL='jdbc:mysql://127.0.0.1:3306/shenzhou_hr?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&sslMode=DISABLED&allowPublicKeyRetrieval=true'
SHENZHOUHR_DB_USERNAME=shenzhouhr_app
SHENZHOUHR_DB_PASSWORD=replace-me
SHENZHOUHR_DB_POOL_SIZE=12
SHENZHOUHR_DB_MIN_IDLE=2
SHENZHOUHR_FLYWAY_ENABLED=false
SHENZHOUHR_FLYWAY_USERNAME=replace-me
SHENZHOUHR_FLYWAY_PASSWORD=replace-me
SHENZHOUHR_SESSION_COOKIE_SECURE=false
# Idle 6 hours, absolute 12 hours. An open page also touches the session.
SHENZHOUHR_SESSION_IDLE_TIMEOUT=PT6H
SHENZHOUHR_SESSION_ABSOLUTE_TIMEOUT=PT12H
# install.sh generates one stable 32-byte base64url secret and writes the same
# 43-character value to both root-owned env files. Never reuse this blank sample.
SHENZHOUHR_PROVISIONING_PEPPER=
SHENZHOUHR_PROVISIONING_KEY_ID=v1
SHENZHOUHR_PROVISIONING_RECOVERY_WINDOW=PT1H
# Keep both integrations disabled until their customer-specific contracts,
# identity mappings and end-to-end reconciliations have passed.
DELI_EPLUS_ENABLED=false
DELI_EPLUS_BASE_URL=https://v2-api.delicloud.com
DELI_EPLUS_APP_KEY=
DELI_EPLUS_APP_SECRET=
DELI_EPLUS_PAGE_SIZE=500
DELI_EPLUS_CONNECT_TIMEOUT=PT5S
DELI_EPLUS_REQUEST_TIMEOUT=PT15S
DELI_EPLUS_MAX_RESPONSE_BYTES=4194304
DELI_EPLUS_SOURCE_TIME_ZONE=Asia/Shanghai
DELI_EPLUS_CREDENTIAL_REFERENCE_NAME=DELI_EPLUS_APP_CREDENTIALS
SHENZHOUHR_DELI_AUTO_SYNC_ENABLED=false
SHENZHOUHR_DELI_AUTO_SYNC_CRON=0 0 0,8,12,18 * * ?
# Identity replay stays off. Turn on only for the confirmed 2026-08 window.
# Daily Deli ingest remains the 00:00/08:00/12:00/18:00 incremental job.
SHENZHOUHR_DELI_REPLAY_ENABLED=false

SHENZHOUHR_OA_AUTO_SYNC_ENABLED=false
SHENZHOUHR_OA_AUTO_SYNC_CRON=0 0 * * * ?
SHENZHOUHR_LEAVE_OA_RECALCULATE_ENABLED=true
SHENZHOUHR_LEAVE_OA_RECALCULATE_CRON=0 0 1 * * ?
SHENZHOUHR_OCR_BAIDU_API_KEY=
SHENZHOUHR_OCR_BAIDU_SECRET_KEY=
SHENZHOUHR_OA_AUTO_SYNC_ZONE=Asia/Shanghai
OA_MYSQL_ENABLED=false
OA_MYSQL_JDBC_URL=
OA_MYSQL_USERNAME=
OA_MYSQL_PASSWORD=
OA_MYSQL_SOURCE_TIME_ZONE=Asia/Shanghai
OA_MYSQL_MAX_POOL_SIZE=2
OA_MYSQL_CONNECTION_TIMEOUT=PT5S
OA_MYSQL_QUERY_TIMEOUT=PT3S
SHENZHOUHR_PAYROLL_RESERVATION_ENABLED=false
