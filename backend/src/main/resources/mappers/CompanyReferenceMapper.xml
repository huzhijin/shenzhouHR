<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szsemicon.hr.referencedata.infrastructure.persistence.CompanyReferenceMapper">
    <select id="findActive"
            resultType="com.szsemicon.hr.referencedata.infrastructure.persistence.CompanyReferenceRow">
        SELECT company.company_id,
               company.code,
               company.name
        FROM company company
        WHERE company.status = 'ACTIVE'
        ORDER BY company.code, company.name, company.company_id
    </select>
</mapper>
